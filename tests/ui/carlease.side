{
  "id": "7f6c2a48-5d19-4a60-9a3a-carlease-ui-tests",
  "version": "2.0",
  "name": "CarLease UI",
  "url": "http://localhost:5173",
  "tests": [
    {
      "id": "t01-home-loads",
      "name": "01 Pagrindinio puslapio užkrovimas",
      "commands": [
        { "id": "c1", "comment": "Atidaromas pagrindinis puslapis", "command": "open", "target": "/", "value": "" },
        { "id": "c2", "comment": "Nustatomas lango dydis", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "comment": "Laukiama kol matoma hero antraštė", "command": "waitForElementVisible", "target": "xpath=//h1[contains(normalize-space(.),'Automobilių nuoma Lietuvoje')]", "value": "10000" },
        { "id": "c4", "comment": "Patikrinama, kad navbar'e yra nuoroda į nuomos katalogą", "command": "assertElementPresent", "target": "xpath=//nav//a[normalize-space(.)='Automobilių nuoma']", "value": "" },
        { "id": "c5", "comment": "Patikrinama, kad navbar'e yra kontaktų nuoroda", "command": "assertElementPresent", "target": "xpath=//nav//a[normalize-space(.)='Kontaktai']", "value": "" },
        { "id": "c6", "comment": "Patikrinama, kad footer'yje yra teisių eilutė su 'Ratai24'", "command": "assertElementPresent", "target": "xpath=//footer//*[contains(normalize-space(.),'Ratai24')]", "value": "" }
      ]
    },
    {
      "id": "t02-nav-home-to-cars",
      "name": "02 Navigacija iš pradžios į nuomos katalogą per navbar",
      "commands": [
        { "id": "c1", "comment": "Atidaromas pagrindinis puslapis", "command": "open", "target": "/", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "comment": "Laukiama kol užkraunamas navbar", "command": "waitForElementVisible", "target": "xpath=//nav//a[normalize-space(.)='Automobilių nuoma']", "value": "10000" },
        { "id": "c4", "comment": "Spaudžiamas navbar'o mygtukas 'Automobilių nuoma'", "command": "click", "target": "xpath=//nav//a[normalize-space(.)='Automobilių nuoma']", "value": "" },
        { "id": "c5", "comment": "Rodoma antraštė 'Automobilių katalogas'", "command": "waitForElementVisible", "target": "xpath=//h1[contains(normalize-space(.),'Automobilių katalogas')]", "value": "10000" },
        { "id": "c6", "comment": "Patikrinama, kad atverstas nuomos katalogo URL", "command": "executeScript", "target": "return window.location.pathname;", "value": "path" },
        { "id": "c7", "command": "assert", "target": "path", "value": "/rent-cars" }
      ]
    },
    {
