        { "id": "c8", "comment": "Spaudžiamas mygtukas – jo tėvas yra <a href='/login'>", "command": "click", "target": "xpath=//button[contains(normalize-space(.),'Prisijunkite, kad rezervuotumėte')]", "value": "" },
