        { "id": "c6", "comment": "Patikrinama, kad URL atitinka detalių puslapį /rent-cars/{id}", "command": "executeScript", "target": "return /\\/rent-cars\\/\\d+$/.test(window.location.pathname);", "value": "isDetail" },
