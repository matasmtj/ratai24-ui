    {
      "id": "t14-cars-detail-login-to-book",
      "name": "14 Automobilio detalių puslapis – 'Prisijunkite, kad rezervuotumėte' nukreipia į /login",
      "commands": [
        { "id": "c1", "command": "open", "target": "/rent-cars", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "xpath=(//a[starts-with(@href,'/rent-cars/')])[1]", "value": "15000" },
        { "id": "c4", "command": "click", "target": "xpath=(//a[starts-with(@href,'/rent-cars/')])[1]", "value": "" },
        { "id": "c5", "command": "waitForElementVisible", "target": "xpath=//button[contains(normalize-space(.),'Prisijunkite, kad rezervuotumėte')]", "value": "15000" },
        { "id": "c6", "command": "executeScript", "target": "return /\\/rent-cars\\/\\d+$/.test(window.location.pathname);", "value": "isDetail" },
        { "id": "c7", "command": "assert", "target": "isDetail", "value": "true" },
        { "id": "c8", "command": "click", "target": "xpath=//button[contains(normalize-space(.),'Prisijunkite, kad rezervuotumėte')]", "value": "" },
        { "id": "c9", "command": "waitForElementVisible", "target": "css=input[type='email']", "value": "10000" },
        { "id": "c10", "command": "executeScript", "target": "return window.location.pathname;", "value": "path" },
        { "id": "c11", "command": "assert", "target": "path", "value": "/login" }
      ]
    },
    {
      "id": "t15-login-empty-captcha-error",
      "name": "15 Prisijungimas be reCAPTCHA rodo klaidos pranešimą",
      "commands": [
        { "id": "c1", "command": "open", "target": "/login", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "css=input[type='email']", "value": "10000" },
        { "id": "c4", "comment": "Įvedamas el. paštas per React-suderinamą JS setter", "command": "executeScript", "target": "var el=document.querySelector(\"input[type='email']\");var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,'testas@ratai24.lt');el.dispatchEvent(new Event('input',{bubbles:true}));return true;", "value": "" },
        { "id": "c5", "comment": "Įvedamas slaptažodis per React-suderinamą JS setter", "command": "executeScript", "target": "var el=document.querySelector(\"input[type='password']\");var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,'Slaptas123');el.dispatchEvent(new Event('input',{bubbles:true}));return true;", "value": "" },
        { "id": "c6", "command": "click", "target": "xpath=//button[@type='button' and normalize-space(.)='Prisijungti']", "value": "" },
        { "id": "c7", "command": "waitForElementVisible", "target": "xpath=//*[contains(normalize-space(.),'Užbaikite reCAPTCHA patikrinimą')]", "value": "5000" }
      ]
    },
