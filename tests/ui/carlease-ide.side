        { "id": "c4", "command": "executeScript", "target": "return window.location.pathname;", "value": "path" },
        { "id": "c5", "command": "assert", "target": "path", "value": "/contacts" }
      ]
    }
  ],
  "suites": [
    {
      "id": "suite-all-ide",
      "name": "Pilnas UI regresinis rinkinys (IDE variantas)",
      "persistSession": false,
      "parallel": false,
      "timeout": 600,
      "tests": [
        "t01-home-loads",
        "t02-nav-home-to-cars",
