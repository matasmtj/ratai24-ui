  "tests": [
    {
      "id": "t01-home-loads",
      "name": "01 Pagrindinio puslapio užkrovimas",
      "commands": [
        { "id": "c1", "command": "open", "target": "/", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "xpath=//h1[contains(normalize-space(.),'Automobilių nuoma Lietuvoje')]", "value": "10000" },
        { "id": "c4", "command": "assertElementPresent", "target": "xpath=//nav//a[normalize-space(.)='Automobilių nuoma']", "value": "" },
        { "id": "c5", "command": "assertElementPresent", "target": "xpath=//nav//a[normalize-space(.)='Kontaktai']", "value": "" },
        { "id": "c6", "command": "assertElementPresent", "target": "xpath=//footer//*[contains(normalize-space(.),'Ratai24')]", "value": "" }
      ]
    },
    {
      "id": "t02-nav-home-to-cars",
