        { "id": "c4", "command": "pause", "target": "1500", "value": "" },
        { "id": "c5", "comment": "Įvedamas nesamas tekstas per React-suderinamą JS setter", "command": "executeScript", "target": "var el=document.querySelector('input[placeholder=\"Paieška (markė/modelis)\"]');var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,'ZZXXNERASIMA');el.dispatchEvent(new Event('input',{bubbles:true}));return true;", "value": "" },
