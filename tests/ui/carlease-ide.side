    {
      "id": "t17-register-password-mismatch",
      "name": "17 Registracija: skirtingi slaptažodžiai rodo 'Slaptažodžiai nesutampa'",
      "commands": [
        { "id": "c1", "command": "open", "target": "/register", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "css=input[type='email']", "value": "10000" },
        { "id": "c4", "comment": "Užpildomi visi laukai per React-suderinamą setter'į", "command": "executeScript", "target": "function fill(sel,val){var el=typeof sel==='number'?document.querySelectorAll(\"input[type='password']\")[sel]:document.querySelector(sel);var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,val);el.dispatchEvent(new Event('input',{bubbles:true}));}fill(\"input[type='email']\",'pavyzdys@ratai24.lt');fill(\"input[placeholder='Vardas']\",'Jonas');fill(\"input[placeholder='Pavardė']\",'Jonaitis');fill(\"input[type='tel']\",'+37060000000');fill(0,'Slaptas123');fill(1,'Kitoks999');return true;", "value": "" },
        { "id": "c5", "command": "click", "target": "xpath=//form//button[@type='submit']", "value": "" },
        { "id": "c6", "command": "waitForElementVisible", "target": "xpath=//*[contains(normalize-space(.),'Slaptažodžiai nesutampa')]", "value": "5000" }
      ]
    },
    {
      "id": "t18-register-weak-password",
      "name": "18 Registracija: per silpnas slaptažodis rodo klaidą apie reikalavimus",
      "commands": [
        { "id": "c1", "command": "open", "target": "/register", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "css=input[type='email']", "value": "10000" },
        { "id": "c4", "comment": "Užpildomi visi laukai; slaptažodis per silpnas", "command": "executeScript", "target": "function fill(sel,val){var el=typeof sel==='number'?document.querySelectorAll(\"input[type='password']\")[sel]:document.querySelector(sel);var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,val);el.dispatchEvent(new Event('input',{bubbles:true}));}fill(\"input[type='email']\",'pavyzdys@ratai24.lt');fill(\"input[placeholder='Vardas']\",'Jonas');fill(\"input[placeholder='Pavardė']\",'Jonaitis');fill(\"input[type='tel']\",'+37060000000');fill(0,'weak');fill(1,'weak');return true;", "value": "" },
        { "id": "c5", "command": "click", "target": "xpath=//form//button[@type='submit']", "value": "" },
        { "id": "c6", "command": "waitForElementVisible", "target": "xpath=//*[contains(normalize-space(.),'Įvykdykite visus slaptažodžio reikalavimus')]", "value": "5000" }
      ]
    },
    {
      "id": "t19-register-missing-phone",
      "name": "19 Registracija: tuščias telefono numeris neleidžia pateikti formos",
      "commands": [
        { "id": "c1", "command": "open", "target": "/register", "value": "" },
        { "id": "c2", "command": "setWindowSize", "target": "1366x768", "value": "" },
        { "id": "c3", "command": "waitForElementVisible", "target": "css=input[type='email']", "value": "10000" },
        { "id": "c4", "comment": "Užpildomi VISI laukai, IŠSKYRUS telefono numerį", "command": "executeScript", "target": "function fill(sel,val){var el=typeof sel==='number'?document.querySelectorAll(\"input[type='password']\")[sel]:document.querySelector(sel);var s=Object.getOwnPropertyDescriptor(HTMLInputElement.prototype,'value').set;s.call(el,val);el.dispatchEvent(new Event('input',{bubbles:true}));}fill(\"input[type='email']\",'pavyzdys@ratai24.lt');fill(\"input[placeholder='Vardas']\",'Jonas');fill(\"input[placeholder='Pavardė']\",'Jonaitis');fill(0,'Slaptas123');fill(1,'Slaptas123');return true;", "value": "" },
        { "id": "c5", "command": "click", "target": "xpath=//form//button[@type='submit']", "value": "" },
        { "id": "c6", "command": "pause", "target": "1500", "value": "" },
        { "id": "c7", "command": "executeScript", "target": "return window.location.pathname;", "value": "path" },
        { "id": "c8", "command": "assert", "target": "path", "value": "/register" },
        { "id": "c9", "comment": "Tel. laukas yra HTML5 :invalid (required užblokavo formą)", "command": "executeScript", "target": "return document.querySelector(\"input[type='tel']\").matches(':invalid');", "value": "telIsInvalid" },
        { "id": "c10", "command": "assert", "target": "telIsInvalid", "value": "true" }
      ]
    },
    {
      "id": "t20-contacts-page-loads",
      "name": "20 Kontaktų puslapio užkrovimas",
      "commands": [
        { "id": "c1", "command": "open", "target": "/contacts", "value": "" },
