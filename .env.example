# Remote/production API (used in production builds and as dev fallback)
VITE_API_URL=https://ratai24.onrender.com

# Local API for dev auto-detection (default: http://localhost:3000)
# VITE_API_URL_LOCAL=http://localhost:3000

# Set to true to always use VITE_API_URL in dev (skip local probe)
# VITE_API_FORCE_REMOTE=true

# How long to wait for local /health during dev startup (ms)
# VITE_API_LOCAL_PROBE_MS=1000

# Google reCAPTCHA v2 Site Key
# Get your site key from: https://www.google.com/recaptcha/admin
# For development, you can use Google's test key: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
